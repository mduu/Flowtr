# Settings for deploy/deploy.sh. Copy to deploy/flowtr.env (not in git) and fill in.
# No secrets here: the script asks for them and puts them into Key Vault.

# Azure subscription only for Flowtr (story #011: the free grant of Container Apps applies per subscription).
SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-flowtr
LOCATION=switzerlandnorth
NAME=flowtr

# Always admin (ADR-004). Also receives alerts and budget warnings, if ALERT_EMAIL is empty.
ADMIN_EMAIL=
ALERT_EMAIL=

# Own domain, for example app.flowtr.ch. Empty: only the generated address of Azure.
DOMAIN=

# IMAP mailbox for the e-mail inbox. Empty: no inbox job.
MAILBOX_HOST=
MAILBOX_USER=
MAILBOX_ADDRESS=

# Image and repository of the pipeline (GitHub Actions sets new images itself).
IMAGE=ghcr.io/mduu/flowtr:latest
GITHUB_REPO=mduu/Flowtr

# Culture for numbers and dates (default de-CH).
CULTURE=de-CH

# Budget per month in the currency of the billing account.
MONTHLY_BUDGET=5
