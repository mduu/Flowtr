@implements IDisposable
@inject ServerStatus Status

@* Only while a call waits for the database. On the server (prerendering, account pages) it never shows. *@
@if (Status.IsWaking)
{
    <div class="server-status" role="status" aria-live="polite">
        <MudPaper Elevation="4" Class="pa-3">
            <MudText Typo="Typo.body2"><strong>Die Datenbank wacht auf …</strong></MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Nach einer Pause dauert das bis zu einer Minute.</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="mt-2" />
        </MudPaper>
    </div>
}

@code {
    protected override void OnInitialized() => Status.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= Refresh;
}
