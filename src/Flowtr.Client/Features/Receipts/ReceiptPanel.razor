@inject IReceiptApi Receipts

@* The receipt at the top of the booking dialog: its files (filed and new), then a drop zone for more (story #012). *@
<div class="receipt-panel">
    @foreach (var file in Shown)
    {
        <MudPaper Outlined="true" Class="receipt-card">
            <a class="thumb" href="@file.Url" target="_blank" rel="noopener" title="Datei ansehen">
                @if (ReceiptUrls.IsPreviewImage(file.ContentType))
                {
                    <img src="@file.Url" alt="Vorschau der Datei" />
                }
                else
                {
                    <MudIcon Icon="@Icon(file.ContentType)" Color="@(file.ContentType == MailContentTypes.Mail ? Color.Primary : Color.Error)" Size="Size.Large" />
                }
            </a>
            <div class="info">
                <MudText Typo="Typo.body2" Class="name">@file.Title</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@file.Subtitle</MudText>
            </div>
            <div class="actions">
                <MudIconButton Href="@file.Url" Target="_blank" Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small"
                               aria-label="@($"{file.Title} ansehen")" title="Ansehen" />
                @if (!ReadOnly)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="file.Remove"
                                   aria-label="@($"{file.Title} entfernen")" title="Entfernen" />
                }
            </div>
        </MudPaper>
    }

    @foreach (var name in uploading)
    {
        <MudPaper Outlined="true" Class="receipt-card">
            <div class="thumb"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" /></div>
            <div class="info">
                <MudText Typo="Typo.body2" Class="name">@name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Wird hochgeladen …</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
            </div>
        </MudPaper>
    }

    @if (Analyzing)
    {
        <div class="analyzing">
            <MudText Typo="Typo.caption" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size: .9rem; vertical-align: -2px" />
                @(Uploads.Count > 1 ? "Dateien werden gelesen …" : "Beleg wird gelesen …")
            </MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Size="Size.Small" Class="mt-1" />
        </div>
    }

    @if (!ReadOnly && Count + uploading.Count < MaxFiles)
    {
        @* The file input lies invisible over the drop zone: a click opens the picker, a drop gives the files. *@
        <MudFileUpload T="IReadOnlyList<IBrowserFile>" @ref="picker" FilesChanged="UploadFiles" Accept="@Accept" DragAndDrop="true" @bind-Dragging="dragging"
                       Class="drop-upload" InputClass="drop-input">
            <CustomContent>
                @if (Count == 0 && uploading.Count == 0)
                {
                    <div class="drop-zone @(dragging ? "dragging" : "")">
                        <MudIcon Icon="@Icons.Material.Outlined.UploadFile" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.body2"><strong>Beleg hierher ziehen</strong> oder auswählen</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">PDF oder Bild, bis 20 MB, auch mehrere · ohne Beleg geht es auch</MudText>
                        </div>
                    </div>
                }
                else
                {
                    <div class="drop-zone more @(dragging ? "dragging" : "")">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Weitere Datei hinzufügen, z.B. die Quittung zur Rechnung</MudText>
                    </div>
                }
            </CustomContent>
            <SelectedTemplate />
        </MudFileUpload>
        <label class="camera">
            <InputFile OnChange="args => UploadFiles(args.GetMultipleFiles(MaxFiles))" accept="image/*" capture="environment" />
            <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" Size="Size.Small" />
            <span>Foto aufnehmen</span>
        </label>
    }
    @if (error is not null)
    {
        <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@error</MudText>
    }
</div>

@code {
    /// <summary>
    /// A receipt has at most this number of files (server: <c>Receipt.MaxFiles</c>).
    /// </summary>
    public const int MaxFiles = 10;

    private const string Accept = ".pdf,.jpg,.jpeg,.png,.heic,.heif,.webp,application/pdf,image/*";

    private MudFileUpload<IReadOnlyList<IBrowserFile>>? picker;
    private bool dragging;
    private readonly List<string> uploading = [];
    private string? error;

    /// <summary>
    /// The filed receipt of the booking, if any.
    /// </summary>
    [Parameter]
    public BookingView? Booking { get; set; }

    /// <summary>
    /// New files: the save adds them to the receipt.
    /// </summary>
    [Parameter]
    public IReadOnlyList<UploadedReceipt> Uploads { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<UploadedReceipt>> UploadsChanged { get; set; }

    /// <summary>
    /// Filed files that the user removed: the save removes them from the receipt.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid> RemovedFiles { get; set; } = new HashSet<Guid>();

    [Parameter]
    public EventCallback<IReadOnlySet<Guid>> RemovedFilesChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// True while the AI reads the new files.
    /// </summary>
    [Parameter]
    public bool Analyzing { get; set; }

    /// <summary>
    /// Where the new files come from (e-mail inbox). Shown instead of the file size.
    /// </summary>
    [Parameter]
    public string? Origin { get; set; }

    private IEnumerable<ReceiptFileView> Filed => (Booking?.ReceiptFiles ?? []).Where(f => !RemovedFiles.Contains(f.Id));

    private int Count => Filed.Count() + Uploads.Count;

    private IEnumerable<ShownFile> Shown =>
        Filed.Select(f => new ShownFile(ReceiptUrls.File(f.Id), f.ContentType, f.FileName, $"Abgelegt · {FileSize(f.Size)}", () => RemoveFiled(f.Id)))
            .Concat(Uploads.Select(u => new ShownFile(ReceiptUrls.Upload(u.UploadId), u.ContentType, u.FileName,
                $"{Origin ?? FileSize(u.Size)} · wird beim Speichern abgelegt", () => RemoveUpload(u))));

    private async Task UploadFiles(IReadOnlyList<IBrowserFile>? files)
    {
        if (files is null || files.Count == 0)
        {
            return;
        }

        error = null;
        var free = MaxFiles - Count - uploading.Count;
        if (files.Count > free)
        {
            error = $"Ein Beleg hat höchstens {MaxFiles} Dateien.";
            files = files.Take(free).ToList();
        }

        uploading.AddRange(files.Select(f => f.Name));
        StateHasChanged();

        var added = new List<UploadedReceipt>();
        foreach (var file in files)
        {
            var result = await Receipts.Upload(file);
            uploading.Remove(file.Name);
            if (result.IsSuccess)
            {
                added.Add(result.Value!);
            }
            else
            {
                error = result.Error;
            }
        }

        if (picker is not null)
        {
            await picker.ClearAsync();
        }

        if (added.Count > 0)
        {
            await UploadsChanged.InvokeAsync([.. Uploads, .. added]);
        }
    }

    private Task RemoveUpload(UploadedReceipt upload) =>
        UploadsChanged.InvokeAsync(Uploads.Where(u => u.UploadId != upload.UploadId).ToList());

    private Task RemoveFiled(Guid fileId) =>
        RemovedFilesChanged.InvokeAsync(new HashSet<Guid>(RemovedFiles) { fileId });

    private static string Icon(string? contentType) => contentType switch
    {
        MailContentTypes.Mail => Icons.Material.Outlined.Email,
        "application/pdf" => Icons.Material.Outlined.PictureAsPdf,
        _ => Icons.Material.Outlined.Image,
    };

    private static string FileSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0} KB",
        _ => $"{bytes / 1024.0 / 1024.0:0.0} MB",
    };

    private sealed record ShownFile(string Url, string? ContentType, string Title, string Subtitle, Func<Task> Remove);
}
