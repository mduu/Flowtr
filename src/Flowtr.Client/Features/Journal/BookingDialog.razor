@using System.ComponentModel.DataAnnotations
@using System.Globalization

@inject IJournalApi Journal
@inject IReceiptApi Receipts
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<MudDialog Class="booking-dialog" ContentClass="booking-dialog-content">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Size="Size.Medium" Color="@KindColor" Variant="Variant.Outlined">
                <MudIcon Icon="@(form.Kind == BookingKind.Income ? Icons.Material.Outlined.TrendingUp : Icons.Material.Outlined.TrendingDown)" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Style="line-height: 1.2">@Title</MudText>
                @if (Booking?.ReceiptNumber is { } receipt)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Beleg @receipt</MudText>
                }
            </div>
            @if (Booking is null && Position + MoreBookings.Count > 1)
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Icon="@Icons.Material.Outlined.CallSplit" Class="ml-1"
                         title="Die KI schlägt zu diesem Beleg mehrere Buchungen vor">
                    Buchung @Position von @(Position + MoreBookings.Count)
                </MudChip>
            }
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (readOnly)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">Das Jahr ist abgeschlossen. Diese Buchung lässt sich nicht mehr ändern.</MudAlert>
        }
        @if (error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@error</MudAlert>
        }
        <ReceiptPanel Booking="Booking" Uploads="uploads" UploadsChanged="UploadsChanged" @bind-RemovedFiles="removedFiles" ReadOnly="readOnly"
                      Analyzing="analyzing" Origin="@(uploads.All(u => InitialUploads?.Contains(u) == true) ? Origin : null)" />
        @if (aiMessage is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => aiMessage = null">@aiMessage</MudAlert>
        }
        @if (MoreBookings.Count > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Icon="@Icons.Material.Outlined.AutoAwesome"
                      ShowCloseIcon="true" CloseIconClicked="DismissMoreBookings">
                Die KI schlägt zu diesem Beleg @(MoreBookings.Count == 1 ? "eine weitere Buchung" : $"{MoreBookings.Count} weitere Buchungen") vor:
                @string.Join(", ", MoreBookings.Select(Summary)).
                Nach dem Speichern öffnet Flowtr @(MoreBookings.Count == 1 ? "sie" : "die nächste") mit demselben Beleg.
            </MudAlert>
        }

        <EditForm id="booking-form" Model="form" OnValidSubmit="Save">
            <DataAnnotationsValidator />

            <div class="hero @(form.Kind == BookingKind.Income ? "income" : "expense")">
                <div class="kind-switch" role="radiogroup" aria-label="Art">
                    <MudButton Variant="@(form.Kind == BookingKind.Expense ? Variant.Filled : Variant.Text)"
                               Color="@(form.Kind == BookingKind.Expense ? Color.Error : Color.Default)" Size="Size.Small" Disabled="readOnly"
                               StartIcon="@Icons.Material.Outlined.TrendingDown" OnClick="() => KindChanged(BookingKind.Expense)"
                               role="radio" aria-checked="@(form.Kind == BookingKind.Expense ? "true" : "false")">Ausgabe</MudButton>
                    <MudButton Variant="@(form.Kind == BookingKind.Income ? Variant.Filled : Variant.Text)"
                               Color="@(form.Kind == BookingKind.Income ? Color.Success : Color.Default)" Size="Size.Small" Disabled="readOnly"
                               StartIcon="@Icons.Material.Outlined.TrendingUp" OnClick="() => KindChanged(BookingKind.Income)"
                               role="radio" aria-checked="@(form.Kind == BookingKind.Income ? "true" : "false")">Einnahme</MudButton>
                </div>
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Betrag CHF</MudText>
                <div class="amount">
                    <MudNumericField @ref="amountField" T="decimal?" @bind-Value="form.AmountChf" For="() => form.AmountChf" Format="0.00" Placeholder="0.00"
                                     Culture="CultureInfo.InvariantCulture" HideSpinButtons="true" InputMode="@(InputMode.@decimal)" ReadOnly="readOnly"
                                     Underline="false" aria-label="Betrag CHF" />
                </div>
                @if (IsProposed(nameof(BookingForm.AmountChf), form.AmountChf) && proposal?.ExchangeRateNote is { } exchange)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@exchange</MudText>
                }
                else if (form.OriginalCurrency is { Length: > 0 } currency && form.OriginalAmount is { } original)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@currency.ToUpperInvariant() @SwissFormat.Amount(original)</MudText>
                }
                @if (IsProposed(nameof(BookingForm.AmountChf), form.AmountChf) || IsProposed(nameof(BookingForm.Kind), form.Kind))
                {
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="ai-hint">
                        <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Style="font-size: .9rem; vertical-align: -2px" /> Von der KI erkannt
                    </MudText>
                }
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Datum" @bind-Date="form.Date" For="() => form.Date" DateFormat="dd.MM.yyyy" Culture="swiss"
                                   Editable="true" ReadOnly="readOnly" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   HelperText="@Hint(nameof(BookingForm.Date), form.Date)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Kategorie" @bind-Value="form.CategoryId" For="() => form.CategoryId" ReadOnly="readOnly"
                               AdornmentIcon="@Icons.Material.Outlined.Category" Variant="Variant.Outlined" Margin="Margin.Dense"
                               HelperText="@Hint(nameof(BookingForm.CategoryId), form.CategoryId)">
                        @foreach (var category in Categories)
                        {
                            <MudSelectItem T="Guid?" Value="category.Id">@category.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="form.Description" For="() => form.Description" Label="Beschreibung" ReadOnly="readOnly"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Notes"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Hint(nameof(BookingForm.Description), form.Description)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="string" Label="Gegenpartei" @bind-Value="form.Counterparty" SearchFunc="SearchCounterparties"
                                     CoerceText="true" CoerceValue="true" ResetValueOnEmptyText="true" ReadOnly="readOnly" MaxItems="8"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Storefront"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Hint(nameof(BookingForm.Counterparty), form.Counterparty)" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="string" Label="Zahlungsart" @bind-Value="form.PaymentMethod" SearchFunc="SearchPaymentMethods"
                                     CoerceText="true" CoerceValue="true" ResetValueOnEmptyText="true" ReadOnly="readOnly" MaxItems="8"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.CreditCard"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Hint(nameof(BookingForm.PaymentMethod), form.PaymentMethod)" />
                </MudItem>
                @if (showForeign)
                {
                    <MudItem xs="8">
                        <MudNumericField T="decimal?" Label="Originalbetrag" @bind-Value="form.OriginalAmount" Format="0.00"
                                         Culture="CultureInfo.InvariantCulture" HideSpinButtons="true" InputMode="@(InputMode.@decimal)" ReadOnly="readOnly"
                                         Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.CurrencyExchange"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@Hint(nameof(BookingForm.OriginalAmount), form.OriginalAmount)" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudTextField @bind-Value="form.OriginalCurrency" Label="Währung" MaxLength="3" ReadOnly="readOnly" Placeholder="USD"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-transform: uppercase" />
                    </MudItem>
                }
                @if (showNote)
                {
                    <MudItem xs="12">
                        <MudTextField @bind-Value="form.Note" Label="Notiz" Lines="2" ReadOnly="readOnly"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.StickyNote2"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
            </MudGrid>

            @if (!readOnly && (!showForeign || !showNote))
            {
                <MudStack Row="true" Spacing="1" Class="mt-3">
                    @if (!showForeign)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => showForeign = true">
                            Fremdwährung
                        </MudButton>
                    }
                    @if (!showNote)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="() => showNote = true">
                            Notiz
                        </MudButton>
                    }
                </MudStack>
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        @if (Booking is not null && !readOnly)
        {
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="Delete" Disabled="busy"
                           aria-label="Löschen" title="Löschen" Class="mr-auto" />
        }
        <MudButton OnClick="() => MudDialog.Cancel()">@(readOnly ? "Schliessen" : "Abbrechen")</MudButton>
        @if (!readOnly)
        {
            <MudButton ButtonType="ButtonType.Submit" form="booking-form" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy"
                       StartIcon="@Icons.Material.Outlined.Check">Speichern</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private static readonly CultureInfo swiss = CultureInfo.GetCultureInfo("de-CH");

    private BookingForm form = new();
    private string? error;
    private bool busy;
    private bool showForeign;
    private bool showNote;
    private MudNumericField<decimal?>? amountField;
    private IReadOnlyList<UploadedReceipt> uploads = [];
    private IReadOnlySet<Guid> removedFiles = new HashSet<Guid>();
    private bool analyzing;
    private string? aiMessage;
    private BookingProposal? proposal;
    private bool moreBookingsDismissed;
    private BookingForm initial = new();

    /// <summary>
    /// The values that came from the AI. A field shows the hint while it still has this value.
    /// </summary>
    private readonly Dictionary<string, object?> proposed = [];
    private bool focusAmount;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Null for a new booking.
    /// </summary>
    [Parameter]
    public BookingView? Booking { get; set; }

    [Parameter]
    public BookingOptions? Options { get; set; }

    [Parameter]
    public DateOnly DefaultDate { get; set; }

    [Parameter]
    public string Title { get; set; } = "";

    /// <summary>
    /// Files that the user dropped on the journal, or the files of a mail in the inbox: the dialog opens with them as receipt.
    /// </summary>
    [Parameter]
    public IReadOnlyList<UploadedReceipt>? InitialUploads { get; set; }

    /// <summary>
    /// The proposal that the AI already made for <see cref="InitialUploads"/> (e-mail inbox). Without it, the dialog reads the files.
    /// </summary>
    [Parameter]
    public BookingProposal? InitialProposal { get; set; }

    /// <summary>
    /// Where <see cref="InitialUploads"/> come from, for example «E-Mail von …».
    /// </summary>
    [Parameter]
    public string? Origin { get; set; }

    /// <summary>
    /// The position of this booking among the bookings that the AI proposed for the receipt (story #017).
    /// </summary>
    [Parameter]
    public int Position { get; set; } = 1;

    private bool readOnly => Booking?.IsLocked == true;

    /// <summary>
    /// The further bookings that the AI proposed for the receipt: after the save, the journal opens them one after the other.
    /// </summary>
    private IReadOnlyList<BookingProposal> MoreBookings =>
        Booking is null && !moreBookingsDismissed && uploads.Count > 0 ? proposal?.MoreBookings ?? [] : [];

    private Color KindColor => form.Kind == BookingKind.Income ? Color.Success : Color.Error;

    /// <summary>
    /// Active categories of the kind, plus the current category of the booking even if it is inactive.
    /// </summary>
    private IEnumerable<CategoryView> Categories =>
        (Options?.Categories ?? []).Where(c => c.Kind == form.Kind && (c.IsActive || c.Id == Booking?.CategoryId));

    protected override void OnInitialized()
    {
        form = Booking is null ? new BookingForm { Date = DefaultDate.ToDateTime(TimeOnly.MinValue) } : BookingForm.From(Booking);
        showForeign = form.OriginalAmount is not null || !string.IsNullOrEmpty(form.OriginalCurrency);
        showNote = !string.IsNullOrEmpty(form.Note);
        initial = form.Copy();
        uploads = InitialUploads ?? [];
    }

    protected override async Task OnInitializedAsync()
    {
        if (uploads.Count > 0 && InitialProposal is not null)
        {
            proposal = InitialProposal;
            Apply(proposal);
        }
        else if (uploads.Count > 0)
        {
            await Analyze();
        }
    }

    /// <summary>
    /// After a new file, the AI reads all new files again: together they are one receipt (story #012).
    /// </summary>
    private async Task UploadsChanged(IReadOnlyList<UploadedReceipt> changed)
    {
        var added = changed.Count > uploads.Count;
        uploads = changed;
        if (added)
        {
            await Analyze();
        }
    }

    /// <summary>
    /// Reads the new files with AI and fills the fields that the user did not fill yet (story #009).
    /// </summary>
    private async Task Analyze()
    {
        var files = uploads.Select(u => u.UploadId).ToList();
        analyzing = true;
        aiMessage = null;
        StateHasChanged();

        var result = await Receipts.Analyze(files);
        analyzing = false;

        if (!result.IsSuccess)
        {
            aiMessage = result.Error;
            return;
        }

        // Other files in the meantime: this proposal is old.
        if (!uploads.Select(u => u.UploadId).SequenceEqual(files))
        {
            return;
        }

        proposal = result.Value!;
        Apply(proposal);
        MudDialog.StateHasChanged();
    }

    /// <summary>
    /// Fills only fields that are still empty: a new booking's fields as they were at the start, an existing booking's empty fields.
    /// </summary>
    private void Apply(BookingProposal p)
    {
        if (p.Kind is { } kind && IsOpen(form.Kind, initial.Kind, isEmpty: false))
        {
            Set(nameof(BookingForm.Kind), kind, value => form.Kind = value);
        }

        if (p.Date is { } date && IsOpen(form.Date, initial.Date, form.Date is null))
        {
            Set<DateTime?>(nameof(BookingForm.Date), date.ToDateTime(TimeOnly.MinValue), value => form.Date = value);
        }

        if (p.AmountChf is { } amount && IsOpen(form.AmountChf, initial.AmountChf, form.AmountChf is null))
        {
            Set<decimal?>(nameof(BookingForm.AmountChf), amount, value => form.AmountChf = value);
        }

        if (p.OriginalAmount is { } original && p.OriginalCurrency is { } currency && form.OriginalAmount is null)
        {
            Set<decimal?>(nameof(BookingForm.OriginalAmount), original, value => form.OriginalAmount = value);
            form.OriginalCurrency = currency;
            showForeign = true;
        }

        if (p.Description is { } description && string.IsNullOrWhiteSpace(form.Description))
        {
            Set(nameof(BookingForm.Description), description, value => form.Description = value);
        }

        if (p.Counterparty is { } counterparty && string.IsNullOrWhiteSpace(form.Counterparty))
        {
            Set<string?>(nameof(BookingForm.Counterparty), counterparty, value => form.Counterparty = value);
        }

        if (p.PaymentMethod is { } method && string.IsNullOrWhiteSpace(form.PaymentMethod))
        {
            Set<string?>(nameof(BookingForm.PaymentMethod), method, value => form.PaymentMethod = value);
        }

        if (p.CategoryId is { } category && form.CategoryId is null && Categories.Any(c => c.Id == category))
        {
            Set<Guid?>(nameof(BookingForm.CategoryId), category, value => form.CategoryId = value);
        }

        if (p.Note is { } note && string.IsNullOrWhiteSpace(form.Note))
        {
            form.Note = note;
            showNote = true;
        }
    }

    private static string Summary(BookingProposal p) =>
        $"{(p.Kind == BookingKind.Income ? "Einnahme" : "Ausgabe")}{(p.AmountChf is { } amount ? $" {SwissFormat.Amount(amount)}" : "")}" +
        (p.Description is { } description ? $" «{description}»" : "");

    private void DismissMoreBookings()
    {
        moreBookingsDismissed = true;
        MudDialog.StateHasChanged();
    }

    private bool IsOpen<T>(T current, T start, bool isEmpty) =>
        Booking is null ? EqualityComparer<T>.Default.Equals(current, start) : isEmpty;

    private void Set<T>(string field, T value, Action<T> set)
    {
        set(value);
        proposed[field] = value;
    }

    private bool IsProposed(string field, object? value) =>
        proposed.TryGetValue(field, out var proposedValue) && Equals(proposedValue, value);

    private string? Hint(string field, object? value) => IsProposed(field, value) ? "Von der KI erkannt" : null;

    /// <summary>
    /// Puts the cursor into the amount: for a new booking, and after a change of the kind while the amount is empty.
    /// </summary>
    /// <remarks>
    /// Only after the render and a short delay: the dialog focuses itself when it opens,
    /// and a browser can move the focus when the kind buttons render again.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if ((firstRender && Booking is null) || focusAmount)
        {
            focusAmount = false;
            await Task.Delay(firstRender ? 150 : 50);
            await FocusAmount();
        }
    }

    private void KindChanged(BookingKind kind)
    {
        form.Kind = kind;
        if (!Categories.Any(c => c.Id == form.CategoryId))
        {
            form.CategoryId = null;
        }

        // The dialog container renders the title: it must render again for the new colour.
        MudDialog.StateHasChanged();

        focusAmount = form.AmountChf is null;
    }

    private async Task FocusAmount()
    {
        if (amountField is not null && !readOnly)
        {
            await amountField.FocusAsync();
        }
    }

    private Task<IEnumerable<string>> SearchCounterparties(string? text, CancellationToken cancellationToken) =>
        Task.FromResult(Search(Options?.Counterparties, text));

    private Task<IEnumerable<string>> SearchPaymentMethods(string? text, CancellationToken cancellationToken) =>
        Task.FromResult(Search(Options?.PaymentMethods, text));

    private static IEnumerable<string> Search(IReadOnlyList<string>? names, string? text) =>
        string.IsNullOrWhiteSpace(text)
            ? names ?? []
            : (names ?? []).Where(name => name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));

    private async Task Save()
    {
        busy = true;
        error = null;
        var next = MoreBookings;
        var input = form.ToInput() with
        {
            UploadIds = uploads.Select(u => u.UploadId).ToList(),
            RemovedFileIds = removedFiles.ToList(),
            KeepUploads = next.Count > 0,
        };

        var result = Booking is null
            ? await Journal.CreateBooking(input)
            : await Journal.UpdateBooking(Booking.Id, input);
        busy = false;

        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }

        Snackbar.Add("Buchung gespeichert.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(new BookingSaved(input.Date, uploads, next)));
    }

    private async Task Delete()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Buchung löschen?",
            $"«{Booking!.Description}» vom {SwissFormat.Date(Booking.Date)} über {SwissFormat.Chf(Booking.AmountChf)}. Das Protokoll behält die Angaben.",
            yesText: "Löschen",
            cancelText: "Abbrechen");

        if (confirmed != true)
        {
            return;
        }

        busy = true;
        var result = await Journal.DeleteBooking(Booking.Id);
        busy = false;

        if (!result.IsSuccess)
        {
            error = result.Error;
            return;
        }

        Snackbar.Add("Buchung gelöscht.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(Booking.Date));
    }

    private sealed class BookingForm
    {
        [Required(ErrorMessage = "Bitte ein Datum angeben.")]
        public DateTime? Date { get; set; }

        public BookingKind Kind { get; set; } = BookingKind.Expense;

        [Required(ErrorMessage = "Bitte einen Betrag angeben.")]
        // Numbers, not text: a limit as text ("0.01") is parsed in the culture of the browser and fails with a decimal comma.
        [Range(0.01, 999_999_999.0, ErrorMessage = "Der Betrag muss grösser als 0 sein.")]
        public decimal? AmountChf { get; set; }

        [Required(ErrorMessage = "Bitte eine Beschreibung angeben.")]
        [StringLength(500, ErrorMessage = "Höchstens 500 Zeichen.")]
        public string Description { get; set; } = "";

        [Required(ErrorMessage = "Bitte eine Kategorie wählen.")]
        public Guid? CategoryId { get; set; }

        public string? Counterparty { get; set; }

        public string? PaymentMethod { get; set; }

        public decimal? OriginalAmount { get; set; }

        public string? OriginalCurrency { get; set; }

        public string? Note { get; set; }

        public BookingForm Copy() => (BookingForm)MemberwiseClone();

        public static BookingForm From(BookingView booking) => new()
        {
            Date = booking.Date.ToDateTime(TimeOnly.MinValue),
            Kind = booking.Kind,
            AmountChf = booking.AmountChf,
            Description = booking.Description,
            CategoryId = booking.CategoryId,
            Counterparty = booking.Counterparty,
            PaymentMethod = booking.PaymentMethod,
            OriginalAmount = booking.OriginalAmount,
            OriginalCurrency = booking.OriginalCurrency,
            Note = booking.Note,
        };

        public BookingInput ToInput() => new(
            DateOnly.FromDateTime(Date!.Value),
            Kind,
            AmountChf!.Value,
            OriginalAmount,
            OriginalCurrency?.ToUpperInvariant(),
            Description,
            CategoryId!.Value,
            Counterparty,
            PaymentMethod,
            Note);
    }
}
