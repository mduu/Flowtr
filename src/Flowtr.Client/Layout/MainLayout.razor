@inherits LayoutComponentBase

<MudThemeProvider Theme="FlowtrTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid var(--mud-palette-lines-default)">
        <a href="" aria-label="Flowtr Startseite"><img src="logo.svg" alt="Flowtr" height="32" style="display:block" /></a>
        <MudSpacer />
        <AccountMenu />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss" title="Schliessen">🗙</span>
</div>
