@implements IDisposable
@inject NavigationManager Navigation

@* A plain form post: it works on the static account pages and in the WebAssembly app. *@
<form class="colour-scheme-switch" method="post" action="darstellung" aria-label="Darstellung">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@Navigation.ToBaseRelativePath(Navigation.Uri)" />
    <button type="submit" name="choice" value="" title="Automatisch – wie das System" aria-label="Automatisch" aria-pressed="@Pressed(ColourScheme.Auto)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M8 20h8M12 16v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <button type="submit" name="choice" value="hell" title="Hell" aria-label="Hell" aria-pressed="@Pressed(ColourScheme.Light)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
    </button>
    <button type="submit" name="choice" value="dunkel" title="Dunkel" aria-label="Dunkel" aria-pressed="@Pressed(ColourScheme.Dark)">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </button>
</form>

@code {
    [CascadingParameter]
    private ColourScheme Scheme { get; set; }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private string Pressed(ColourScheme scheme) => scheme == Scheme ? "true" : "false";

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
