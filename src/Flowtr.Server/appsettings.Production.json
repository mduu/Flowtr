{
  "Logging": {
    "LogLevel": {
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    // The console goes to Log Analytics (errors at the start of a container): only warnings and errors.
    // A provider level replaces the levels of the categories, thus the noisy categories again.
    "Console": {
      "LogLevel": {
        "Default": "Warning",
        "Azure.Core": "Error",
        "Azure.Identity": "Error"
      }
    }
  }
}
