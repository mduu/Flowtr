@using Flowtr.Client.Layout
@using Flowtr.Server.CrossCutting.Hosting
@using Flowtr.Server.Features.Appearance
@inject AppCulture Culture
<!DOCTYPE html>
<html lang="@Culture.Culture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Flowtr.Server.styles.css"]" />
    <ImportMap AdditionalAttributes="ImportMapAttributes" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" ColourScheme="ColourScheme" />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="@Assets["js/start.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="@Assets["js/submit-progress.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private ColourScheme ColourScheme => ColourSchemeCookie.Read(HttpContext);

    // The import map is an inline script: the Content-Security-Policy allows it with the nonce of the request.
    private Dictionary<string, object> ImportMapAttributes => new() { ["nonce"] = SecurityHeaders.Nonce(HttpContext) ?? "" };

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveWebAssembly : null;
}
