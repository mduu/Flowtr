@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Flowtr.Server.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Persönliche Daten</PageTitle>

<StatusMessage />
<MudText Typo="Typo.h6" GutterBottom="true">Persönliche Daten</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Hier kannst du die persönlichen Daten deines Kontos herunterladen oder dein Konto löschen.
</MudText>
<MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Download">Herunterladen</MudButton>
    </form>
    <MudButton Href="Account/Manage/DeletePersonalData" Variant="Variant.Outlined" Color="Color.Error"
               StartIcon="@Icons.Material.Outlined.Delete">Konto löschen</MudButton>
</MudStack>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
