@page "/Account/AcceptInvitation"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Flowtr.Server.CrossCutting.Cqs
@using Flowtr.Server.Data
@using AcceptInvitationCommand = Flowtr.Server.Features.Users.Commands.AcceptInvitation
@using Flowtr.Server.Features.Users.Queries
@using Flowtr.Shared

@inject IQueryHandler<CheckInvitation, string> CheckHandler
@inject ICommandHandler<AcceptInvitationCommand, Result> AcceptHandler
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Einladung annehmen</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">Willkommen bei Flowtr</MudText>

@if (invitationError is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">@invitationError</MudAlert>
    <MudButton Href="Account/Login" Variant="Variant.Outlined" Color="Color.Primary">Zur Anmeldung</MudButton>
}
else
{
    <MudText Typo="Typo.body1" Class="mb-4">
        Du bist eingeladen als <strong>@email</strong>. Wähle ein Passwort, um dein Konto einzurichten.
        Danach kannst du einen Passkey hinzufügen.
    </MudText>

    <StatusMessage Message="@errorMessage" />
    <EditForm Model="Input" FormName="accept-invitation" OnValidSubmit="Accept" method="post">
        <DataAnnotationsValidator />
        @* For password managers: they save the password with this user name. *@
        <input type="text" name="username" value="@email" autocomplete="username" hidden />
        <MudStack Spacing="3">
            <MudStaticTextField @bind-Value="Input.Password" For="() => Input.Password" Label="Passwort" Variant="Variant.Outlined"
                                InputType="InputType.Password" autocomplete="new-password" />
            <MudStaticTextField @bind-Value="Input.ConfirmPassword" For="() => Input.ConfirmPassword" Label="Passwort bestätigen" Variant="Variant.Outlined"
                                InputType="InputType.Password" autocomplete="new-password" />
            <MudStaticButton FormAction="FormAction.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large">
                Konto einrichten
            </MudStaticButton>
        </MudStack>
    </EditForm>
}

@code {
    private string? email;
    private string? invitationError;
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        var invitation = await CheckHandler.Handle(new CheckInvitation(UserId, Code), CancellationToken.None);
        if (invitation.IsSuccess)
        {
            email = invitation.Value;
        }
        else
        {
            invitationError = invitation.Error;
        }
    }

    private async Task Accept()
    {
        if (invitationError is not null)
        {
            return;
        }

        var accepted = await AcceptHandler.Handle(new AcceptInvitationCommand(UserId, Code, Input.Password), CancellationToken.None);
        if (!accepted.IsSuccess)
        {
            errorMessage = $"{StatusMessage.ErrorPrefix} {accepted.Error}";
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId!);
        await SignInManager.SignInAsync(user!, isPersistent: false);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/Passkeys",
            "Dein Konto ist eingerichtet. Richte jetzt einen Passkey ein, dann meldest du dich ohne Passwort an.",
            HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte Passwort angeben.")]
        [StringLength(100, ErrorMessage = "Das Passwort muss zwischen {2} und {1} Zeichen lang sein.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
