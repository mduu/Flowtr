@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Flowtr.Server.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>E-Mail bestätigen</PageTitle>

<MudText Typo="Typo.h5" GutterBottom="true">E-Mail bestätigen</MudText>
<StatusMessage Message="@statusMessage" />
<MudLink Href="Account/Login" Typo="Typo.body2">Zur Anmeldung</MudLink>

@code {
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = "Fehler: Das Konto wurde nicht gefunden.";
        }
        else
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            statusMessage = result.Succeeded ? "Danke, deine E-Mail-Adresse ist bestätigt." : "Fehler: Die E-Mail-Adresse konnte nicht bestätigt werden.";
        }
    }
}
