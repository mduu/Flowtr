@inherits LayoutComponentBase
@layout Flowtr.Client.Layout.MainLayout

@* Account pages are static SSR: only use MudBlazor components that render without interactivity. *@
<MudText Typo="Typo.h5" Class="mb-4">Konto verwalten</MudText>
<MudGrid Spacing="4">
    <MudItem xs="12" md="3">
        <MudPaper Outlined="true" Class="py-2">
            <ManageNavMenu />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="9">
        <MudPaper Outlined="true" Class="pa-6">
            @Body
        </MudPaper>
    </MudItem>
</MudGrid>
