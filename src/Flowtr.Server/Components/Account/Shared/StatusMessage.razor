@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var isError = DisplayMessage.StartsWith(ErrorPrefix);
    <MudAlert Severity="@(isError ? Severity.Error : Severity.Success)" Class="mb-4" role="alert">
        @(isError ? DisplayMessage[ErrorPrefix.Length..].TrimStart() : DisplayMessage)
    </MudAlert>
}

@code {
    /// <summary>
    /// Messages starting with this prefix are shown as error.
    /// </summary>
    public const string ErrorPrefix = "Fehler:";

    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
