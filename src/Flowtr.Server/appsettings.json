{
  // Only what says something: noise costs in Application Insights and hides the errors (story #011).
  // HttpClient tells each request in four lines with the URI: at Solar Lens, that was four fifths of the log.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning",
      "Azure.Core": "Error",
      "Azure.Identity": "Warning"
    }
  },
  // Always admins (ADR-004). In production as app setting Admins__0.
  "Admins": [
    "marc@marcduerst.com"
  ]
}
